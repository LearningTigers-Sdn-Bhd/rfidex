<Project Sdk="Microsoft.NET.Sdk">
  <!-- The gate helper, written in the language of the vendor's gate demos.
       rfidclib_reader.dll is loaded at run time from the RfiDex install
       folder (it is not redistributed in this repository). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>rfidex-gate-host</AssemblyName>
    <RootNamespace>RfiDex.GateHost</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
